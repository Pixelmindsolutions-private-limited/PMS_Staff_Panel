{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "main": "electron.js",
  "dependencies": {
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "avatar": "^0.1.0",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.6",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.0",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.475.0",
    "react": "^18.0.0",
    "react-csv": "^2.2.2",
    "react-datepicker": "^8.1.0",
    "react-dom": "^18.0.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.2.0",
    "react-scripts": "^5.0.1",
    "reactstrap": "^9.2.3",
    "recharts": "^2.15.1",
    "remixicon": "^4.6.0",
    "tailwind-merge": "^3.0.2",
    "tailwind-variants": "^0.3.1",
    "uiohook-napi": "^1.5.5",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "extends": null,
    "appId": "com.pixelmind.pmsstaff",
    "productName": "PMS Staff Widget",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron.js",
      "preload.js",
      "build/**/*",
      "pms_logo.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "pms_logo.ico",
      "signAndEditExecutable": false,
      "artifactName": "PMS-Staff-Widget-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
